{
  "manifest_version": 3,
  "name": "Random URL Jumper",
  "version": "2.1",
  "description": "설정된 규칙 또는 크롤링된 게시글 목록 기반으로 URL을 무작위 탐색합니다.",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Random URL Jumper",
    "default_icon": {
      "16": "assets/icon.png",
      "48": "assets/icon.png",
      "128": "assets/icon.png"
    }
  },
  "options_page": "options/options.html",
  "commands": {
    "jump_now": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "즉시 무작위 URL로 이동"
    }
  },
  "icons": {
    "16": "assets/icon.png",
    "48": "assets/icon.png",
    "128": "assets/icon.png"
  }
}
